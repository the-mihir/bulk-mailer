{
  "name": "bulk-mailer",
  "productName": "Bulk Mailer",
  "version": "1.0.0",
  "description": "Local desktop bulk mailer powered by Resend",
  "author": {
    "name": "Mihir Das",
    "url": "https://mihirdas.io"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs --publish never",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.cjs --publish never",
    "dist": "npm run build && electron-builder --mac --win --config electron-builder.config.cjs --publish never",
    "postinstall": "electron-builder install-app-deps",
    "icon": "node scripts/make-icon.mjs",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://mihirdas.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-mihir/bulk-mailer.git"
  },
  "bugs": {
    "url": "https://github.com/the-mihir/bulk-mailer/issues"
  }
}
